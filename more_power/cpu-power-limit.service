[Unit]
Description=Set Intel CPU MMIO RAPL power limit
After=multi-user.target

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'echo 25000000 > /sys/class/powercap/intel-rapl-mmio:0/constraint_0_power_limit_uw && echo 25000000 > /sys/class/powercap/intel-rapl:0/constraint_0_power_limit_uw && echo 25000000 > /sys/class/powercap/intel-rapl-mmio:0/constraint_1_power_limit_uw'
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
