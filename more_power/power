#!/bin/bash
set -e

if [[ $# -ne 1 ]] || ! [[ "$1" =~ ^[0-9]+([.][0-9]+)?$ ]]; then
    echo "Usage: power <watts>"
    exit 1
fi

RESULT=$(awk "BEGIN {printf \"%.0f\", $1 * 1000000}")

# The three power-limit files.
LIMITS=(
    "/sys/class/powercap/intel-rapl-mmio:0/constraint_0_power_limit_uw"
    "/sys/class/powercap/intel-rapl:0/constraint_0_power_limit_uw"
    "/sys/class/powercap/intel-rapl-mmio:0/constraint_1_power_limit_uw"
)

# Apply the requested limit to all three files.
for f in "${LIMITS[@]}"; do
    echo "$RESULT" | sudo tee "$f" > /dev/null
done

# Save the desired limit persistently.
sudo mkdir -p /var/lib/cpu-power-limit
echo "$RESULT" | sudo tee /var/lib/cpu-power-limit/target_uw > /dev/null

echo "CPU power limit set to $1 W and saved."
