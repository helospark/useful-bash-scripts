#!/bin/bash

if ! [[ "$1" =~ ^[0-9]+(\.[0-9]+)?$ ]]; then
    echo "Error: '$1' is not a valid numeric value." >&2
    exit 1
fi

RESULT=$(awk "BEGIN {print int($1 * 1000000)}")

echo "$RESULT" | sudo tee /sys/class/powercap/intel-rapl-mmio:0/constraint_0_power_limit_uw > /dev/null
echo "$RESULT" | sudo tee /sys/class/powercap/intel-rapl:0/constraint_0_power_limit_uw > /dev/null
echo "$RESULT" | sudo tee /sys/class/powercap/intel-rapl-mmio:0/constraint_1_power_limit_uw > /dev/null
